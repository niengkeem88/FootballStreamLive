<?xml version="1.0" encoding="utf-8"?>
<com.applovin.mediation.nativeAds.MaxNativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#242424"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/applovin_native_icon_image_view"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="Ad Icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/applovin_native_title_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#F5F5F5"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/applovin_native_body_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B0B0B0"
                android:textSize="14sp" />

            <Button
                android:id="@+id/applovin_native_cta_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#39FF14"
                android:textColor="#0D0D0D"
                android:textSize="12sp" />

        </LinearLayout>
    </LinearLayout>
</com.applovin.mediation.nativeAds.MaxNativeAdView>
